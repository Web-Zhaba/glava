static func get_random_event(season: String) -> Dictionary:
	var eligible = events_pool.filter(func(e): 
		var match_season = (e["season"] == season or e["season"] == "any")
		var is_unique = e.get("is_unique", false)
		var is_already_happened = e["id"] in GameState.triggered_events
		return match_season and not (is_unique and is_already_happened)
	)
	if eligible.is_empty():
		return {}
	
	var chosen = eligible.pick_random()
	if chosen.get("is_unique", false):
		GameState.triggered_events.append(chosen["id"])
	
	return chosen
